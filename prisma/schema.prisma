  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([businessId, status, createdAt])
  @@index([subscriptionId, status, createdAt])
  @@map("subscription_payments")
}

model BetaInvite {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  email        String?
  businessName String?
  createdById  String
  expiresAt    DateTime
  usedAt       DateTime?
  usedById     String?
  createdAt    DateTime @default(now())

  @@index([createdById, createdAt])
  @@index([expiresAt, usedAt])
  @@map("beta_invites")
}

/// Small, aggregate-only counters used to protect public signup in a
/// serverless deployment. Raw email addresses and IP addresses are never
/// stored; the key is an HMAC digest scoped to a single time window.
model SignupRateLimit {
  keyHash         String   @id
  scope           String
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
  @@map("signup_rate_limits")
}

/// Durable, privacy-preserving counters for authentication and public API
/// abuse protection across multiple serverless instances.
model SecurityRateLimit {
  keyHash         String   @id
  scope           String
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([scope, expiresAt])
  @@index([expiresAt])
  @@map("security_rate_limits")
}

model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt, usedAt])
  @@map("auth_tokens")
}

model OwnerEmailChangeRequest {
