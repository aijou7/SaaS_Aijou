generator client {
  provider = "prisma-client"
  output   = "../generated/prisma-beta"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  PURGING
}

enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum FeedbackCategory {
  BUG
  IDEA
  CONFUSING
  SUPPORT
  OTHER
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  LOGIN_OTP
  PASSWORD_RESET
}

enum ContactType {
  OWNER
  CUSTOMER
  UNKNOWN
}

enum ConversationType {
  PERSONAL_FINANCE
  CUSTOMER_SERVICE
  UNKNOWN
}

enum ConversationStatus {
  OPEN
  PENDING_CONFIRMATION
  HUMAN_NEEDED
  CLOSED
}

enum SenderType {
  USER
  CUSTOMER
  AI
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum ProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED_DUPLICATE
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum TransactionStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  NEEDS_REVIEW
  REJECTED
  CANCELLED
}

enum TransactionSource {
  WHATSAPP_TEXT
  WHATSAPP_RECEIPT
  DASHBOARD_MANUAL
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum ReviewStatus {
  PENDING
  REVIEWED
  NEEDS_REVIEW
  REJECTED
}

enum KnowledgeSourceType {
  MANUAL
  ONBOARDING
  WEBSITE
  FILE
  CONVERSATION
}

enum KnowledgeReviewStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum LeadStatus {
  NEW
  NEED_FOLLOW_UP
  QUALIFIED
  WON
  LOST
  CLOSED
  SPAM
}

enum ConfirmationStatus {
  ACTIVE
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum ActorType {
  USER
  AI
  SYSTEM
}

enum PaymentProvider {
  XENDIT
  MANUAL
}

enum PaymentSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELLED
  FAILED
}

enum SubscriptionPlan {
  BETA
  STARTER
  GROWTH
  BUSINESS
}

enum SubscriptionBillingCycle {
  MONTHLY
  ANNUAL
}

enum WorkspaceSubscriptionStatus {
  PENDING_ACTIVATION
  TRIALING
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum SubscriptionPaymentProvider {
  MIDTRANS
}

enum SubscriptionPaymentStatus {
  PENDING
  SETTLED
  FAILED
  EXPIRED
  CANCELED
  REFUNDED
  CHARGEBACK
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  QUOTED
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum WorkflowRunStatus {
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  phoneNumber           String?
  role                  UserRole               @default(OWNER)
  status                UserStatus             @default(ACTIVE)
  isPlatformAdmin       Boolean                @default(false)
  emailVerifiedAt       DateTime?
  lastLoginAt           DateTime?
  lastSeenAt            DateTime?
  signupSource          String                 @default("PUBLIC")
  signupAttribution     Json?
  suspendedAt           DateTime?
  deletionRequestedAt   DateTime?
  businesses            Business[]
  memberships           WorkspaceMembership[]
  authTokens            AuthToken[]
  ownerEmailChanges     OwnerEmailChangeRequest[]
  feedback              Feedback[]
  teamInvitesCreated    TeamInvite[]           @relation("TeamInviteCreator")
  teamInvitesAccepted   TeamInvite[]           @relation("TeamInviteAcceptor")
  assignedConversations WhatsAppConversation[] @relation("ConversationAssignee")
  sentMessages          WhatsAppMessage[]      @relation("MessageHumanSender")
  notifications         WorkspaceNotification[]
  transactions          Transaction[]
  assignedComplaints    Complaint[]            @relation("ComplaintAssignee")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([lastSeenAt])
  @@map("users")
}

model Business {
  id                   String                 @id @default(cuid())
  userId               String
  businessName         String
  businessType         String?
  whatsappNumber       String?
  serviceArea          String?
  operatingHours       String?
  mainServices         String?
  websiteUrl           String?
  widgetAllowedOrigin  String?
  widgetLastSeenAt     DateTime?
  widgetKey            String                 @unique @default(cuid())
  address              String?
  onboardingCompleted  Boolean                @default(false)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts             Contact[]
  conversations        WhatsAppConversation[]
  mediaFiles           MediaFile[]
  transactions         Transaction[]
  categories           Category[]
  projects             Project[]
  confirmationSessions ConfirmationSession[]
  aiLogs               AiLog[]
  usageLogs            UsageLog[]
  auditLogs            AuditLog[]
  knowledgeBase        KnowledgeBase[]
  products             Product[]
  leads                Lead[]
  proposalDrafts       ProposalDraft[]
  quickReplies         QuickReply[]
  paymentSettings      PaymentSettings?
  paymentSessions      PaymentSession[]
  subscription         WorkspaceSubscription?
  subscriptionPayments SubscriptionPayment[]
  backgroundJobs       BackgroundJob[]
  notifications        WorkspaceNotification[]
  agentSettings        AgentSettings?
  whatsAppSettings     WhatsAppSettings?
  telegramSettings     TelegramSettings?
  memberships          WorkspaceMembership[]
  teamInvites          TeamInvite[]
  feedback             Feedback[]
  activationEvents     ActivationEvent[]
  customerSegments     CustomerSegment[]
  complaints           Complaint[]
  broadcasts           BroadcastCampaign[]
  orders               Order[]
  shippingRates        ShippingRate[]
  workflows            AutomationWorkflow[]
  workflowRuns         AutomationRun[]
  ownerEmailChanges    OwnerEmailChangeRequest[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([userId])
  @@index([websiteUrl])
  @@index([widgetAllowedOrigin])
  @@map("businesses")
}

model Contact {
  id            String                 @id @default(cuid())
  businessId    String
  phoneNumber   String
  displayName   String?
  contactType   ContactType            @default(UNKNOWN)
  email         String?
  tags          String[]               @default([])
  marketingOptInAt  DateTime?
  marketingOptOutAt DateTime?
  lastContactedAt   DateTime?
  business      Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations WhatsAppConversation[]
  segmentMemberships ContactSegment[]
  complaints    Complaint[]
  broadcastRecipients BroadcastRecipient[]
  orders        Order[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([businessId, phoneNumber])
  @@index([businessId, marketingOptInAt, marketingOptOutAt])
  @@map("contacts")
}

model WhatsAppConversation {
  id                   String                @id @default(cuid())
  businessId           String
  contactId            String?
  conversationType     ConversationType      @default(UNKNOWN)
  status               ConversationStatus    @default(OPEN)
  lastMessageAt        DateTime?
  ownerLastReadAt      DateTime?
  ownerNotes           String?
  resolvedAt           DateTime?
  channel              String                @default("WHATSAPP")
  sessionExpiresAt     DateTime?
  lastCustomerMessageAt DateTime?
  unreadCount          Int                   @default(0)
  assignedToUserId     String?
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact              Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedToUser       User?                 @relation("ConversationAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages             WhatsAppMessage[]
  transactions         Transaction[]
  confirmationSessions ConfirmationSession[]
  aiLogs               AiLog[]
  leads                Lead[]
  complaints           Complaint[]
  orders               Order[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([businessId, lastMessageAt])
  @@index([businessId, ownerLastReadAt])
  @@index([businessId, status, lastMessageAt])
  @@index([businessId, conversationType, lastMessageAt])
  @@index([businessId, channel, sessionExpiresAt])
  @@index([businessId, assignedToUserId, status])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id                String               @id @default(cuid())
  conversationId    String
  providerMessageId String               @unique
  senderType        SenderType
  messageType       MessageType
  messageBody       String?
  mediaFileId       String?
  rawPayload        Json?
  intent            String?
  processingStatus  ProcessingStatus     @default(RECEIVED)
  deliveryStatus    String               @default("STORED")
  deliveryError     String?
  deliveredAt       DateTime?
  sentByUserId      String?
  conversation      WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mediaFile         MediaFile?           @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  sentByUser        User?                @relation("MessageHumanSender", fields: [sentByUserId], references: [id], onDelete: SetNull)
  aiLogs            AiLog[]
  createdAt         DateTime             @default(now())

  @@index([conversationId, createdAt])
  @@map("whatsapp_messages")
}

model MediaFile {
  id              String            @id @default(cuid())
  businessId      String
  providerMediaId String?
  fileUrl         String?
  fileType        String
  mimeType        String?
  fileSize        Int?
  storagePath     String?
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages        WhatsAppMessage[]
  receipts        Receipt[]
  createdAt       DateTime          @default(now())

  @@index([businessId, createdAt])
  @@map("media_files")
}

model Transaction {
  id                   String                @id @default(cuid())
  businessId           String
  userId               String?
  conversationId       String?
  transactionType      TransactionType       @default(EXPENSE)
  transactionDate      DateTime
  merchantName         String?
  categoryId           String?
  projectId            String?
  totalAmount          Decimal               @db.Decimal(14, 2)
  currency             String                @default("IDR")
  description          String?
  source               TransactionSource
  status               TransactionStatus     @default(DRAFT)
  confidenceScore      Decimal?              @db.Decimal(5, 4)
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation         WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  project              Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items                TransactionItem[]
  receipt              Receipt?
  paymentSessions      PaymentSession[]
  confirmationSessions ConfirmationSession[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([businessId, transactionDate])
  @@index([businessId, status])
  @@index([businessId, transactionType, status, transactionDate])
  @@index([businessId, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  itemName      String
  quantity      Decimal?    @db.Decimal(10, 2)
  unitPrice     Decimal?    @db.Decimal(14, 2)
  subtotal      Decimal?    @db.Decimal(14, 2)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("transaction_items")
}

model Category {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  type         CategoryType  @default(EXPENSE)
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([businessId, name, type])
  @@map("categories")
}

model Project {
  id           String        @id @default(cuid())
  businessId   String
  projectName  String
  clientName   String?
  status       String        @default("active")
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([businessId, projectName])
  @@map("projects")
}

model Receipt {
  id              String       @id @default(cuid())
  transactionId   String       @unique
  mediaFileId     String
  rawOcrText      String?
  extractedJson   Json?
  confidenceScore Decimal?     @db.Decimal(5, 4)
  reviewStatus    ReviewStatus @default(PENDING)
  transaction     Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  mediaFile       MediaFile    @relation(fields: [mediaFileId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([reviewStatus, createdAt])
  @@map("receipts")
}

model KnowledgeBase {
  id              String                @id @default(cuid())
  businessId      String
  title           String
  content         String
  category        String?
  isActive        Boolean               @default(true)
  sourceType      KnowledgeSourceType   @default(MANUAL)
  reviewStatus    KnowledgeReviewStatus @default(APPROVED)
  sourceUrl       String?
  sourceName      String?
  sourceMessageId String?
  priority        Int                   @default(80)
  extractedMeta   Json?
  approvedAt      DateTime?
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([businessId, isActive, reviewStatus, priority])
  @@index([businessId, sourceType, updatedAt])
  @@index([sourceMessageId])
  @@map("knowledge_base")
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(14, 2)
  currency    String   @default("IDR")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId, isActive, sortOrder])
  @@map("products")
}

model QuickReply {
  id         String   @id @default(cuid())
  businessId String
  name       String
  content    String
  shortcut   String?
  category   String?
  isPrivate  Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId, isActive, sortOrder])
  @@map("quick_replies")
}

model AgentSettings {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  agentName           String   @default("AI Assistant")
  tone                String   @default("friendly")
  language            String   @default("id")
  openingMessage      String?
  closingMessage      String?
  businessDescription String?
  handoffRules        String?
  systemInstruction   String?
  businessHoursEnabled Boolean @default(false)
  businessHours        Json?
  timeZone             String   @default("Asia/Makassar")
  afterHoursMode       String   @default("HANDOFF")
  afterHoursMessage    String?
  isActive            Boolean  @default(false)
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("agent_settings")
}

model CustomerSegment {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  color       String   @default("#2563eb")
  criteria    Json?
  isDynamic   Boolean  @default(false)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships ContactSegment[]
  campaigns   BroadcastCampaign[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId, createdAt])
  @@map("customer_segments")
}

model ContactSegment {
  contactId String
  segmentId String
  contact   Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  segment   CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@id([contactId, segmentId])
  @@index([segmentId, createdAt])
  @@map("contact_segments")
}

model Complaint {
  id                String            @id @default(cuid())
  businessId        String
  ticketNumber      String
  contactId         String?
  conversationId    String?
  assignedToUserId  String?
  title             String
  description       String
  category          String?
  source            String            @default("MANUAL")
  priority          ComplaintPriority @default(NORMAL)
  status            ComplaintStatus   @default(OPEN)
  slaDueAt          DateTime?
  firstResponseAt   DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact           Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation      WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedToUser    User?             @relation("ComplaintAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  events            ComplaintEvent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([businessId, ticketNumber])
  @@index([businessId, status, priority, createdAt])
  @@index([businessId, slaDueAt])
  @@map("complaints")
}

model ComplaintEvent {
  id          String    @id @default(cuid())
  complaintId String
  actorId     String?
  type        String
  note        String?
  metadata    Json?
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
  @@map("complaint_events")
}

model BroadcastCampaign {
  id             String          @id @default(cuid())
  businessId     String
  segmentId      String?
  name           String
  templateName   String
  languageCode   String          @default("id")
  bodyParameters Json?
  status         BroadcastStatus @default(DRAFT)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  totalRecipients Int            @default(0)
  sentCount      Int             @default(0)
  failedCount    Int             @default(0)
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  segment        CustomerSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients     BroadcastRecipient[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([businessId, status, createdAt])
  @@index([status, scheduledAt])
  @@map("broadcast_campaigns")
}

model BroadcastRecipient {
  id                String                   @id @default(cuid())
  campaignId        String
  contactId         String
  phoneNumber       String
  status            BroadcastRecipientStatus @default(PENDING)
  providerMessageId String?
  errorCode         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  campaign          BroadcastCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact           Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([campaignId, contactId])
  @@index([campaignId, status, createdAt])
  @@index([providerMessageId])
  @@map("broadcast_recipients")
}

model Order {
  id              String         @id @default(cuid())
  businessId      String
  orderNumber     String
  contactId       String?
  conversationId  String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  shippingAddress String?
  shippingZone    String?
  shippingService String?
  weightGrams     Int            @default(0)
  subtotal        Decimal        @db.Decimal(14, 2)
  shippingCost    Decimal        @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal        @db.Decimal(14, 2)
  currency        String         @default("IDR")
  status          OrderStatus    @default(DRAFT)
  paymentStatus   String         @default("UNPAID")
  shipmentStatus  ShipmentStatus @default(PENDING)
  trackingNumber  String?
  notes           String?
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact         Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation    WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([businessId, orderNumber])
  @@index([businessId, status, createdAt])
  @@index([businessId, customerPhone])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String?
  name       String
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(14, 2)
  subtotal   Decimal @db.Decimal(14, 2)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model ShippingRate {
  id              String   @id @default(cuid())
  businessId      String
  zoneName        String
  serviceName     String
  minWeightGrams  Int      @default(0)
  maxWeightGrams  Int?
  basePrice       Decimal  @db.Decimal(14, 2)
  pricePerKg      Decimal  @default(0) @db.Decimal(14, 2)
  estimatedDays   String?
  isActive        Boolean  @default(true)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([businessId, zoneName, serviceName, minWeightGrams])
  @@index([businessId, isActive, zoneName])
  @@map("shipping_rates")
}

model AutomationWorkflow {
  id          String         @id @default(cuid())
  businessId  String
  name        String
  description String?
  triggerType String
  steps       Json
  status      WorkflowStatus @default(DRAFT)
  runCount    Int            @default(0)
  lastRunAt   DateTime?
  lastError   String?
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  runs        AutomationRun[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([businessId, name])
  @@index([businessId, status, triggerType])
  @@map("automation_workflows")
}

model AutomationRun {
  id          String            @id @default(cuid())
  businessId  String
  workflowId  String
  triggerType String
  context     Json
  result      Json?
  status      WorkflowRunStatus @default(RUNNING)
  error       String?
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workflow    AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([businessId, status, startedAt])
  @@index([workflowId, startedAt])
  @@map("automation_runs")
}

model WhatsAppSettings {
  id             String   @id @default(cuid())
  businessId     String   @unique
  wabaId         String?
  phoneNumberId  String?
  accessToken    String?
  verifyToken    String?
  appSecret      String?
  webhookUrl     String?
  isActive       Boolean  @default(false)
  lastConnectedAt DateTime?
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([phoneNumberId])
  @@map("whatsapp_settings")
}

model TelegramSettings {
  id              String    @id @default(cuid())
  businessId      String    @unique
  botToken        String?
  botId           String?   @unique
  botUsername     String?
  webhookKey      String?
  webhookKeyHash  String?   @unique
  webhookSecret   String?
  webhookUrl      String?
  isActive        Boolean   @default(false)
  lastConnectedAt DateTime?
  lastError       String?
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("telegram_settings")
}

model Lead {
  id              String               @id @default(cuid())
  businessId      String
  conversationId  String
  customerName    String?
  customerPhone   String?
  needSummary     String
  serviceInterest String?
  location        String?
  budget          String?
  urgency         String?
  source          String               @default("CHAT")
  qualificationScore Int?
  estimatedValueMin Decimal?           @db.Decimal(14, 2)
  estimatedValueMax Decimal?           @db.Decimal(14, 2)
  estimateNote    String?
  nextStep        String?
  lastCustomerMessageAt DateTime?
  nextFollowUpAt  DateTime?
  followUpReason  String?
  status          LeadStatus           @default(NEW)
  ownerNotes      String?
  extractedJson   Json?
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation    WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposalDrafts  ProposalDraft[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([businessId, conversationId])
  @@index([businessId, status])
  @@index([businessId, source])
  @@index([businessId, qualificationScore])
  @@index([businessId, nextFollowUpAt])
  @@map("leads")
}

model ProposalDraft {
  id                String   @id @default(cuid())
  businessId        String
  leadId            String
  title             String
  clientName        String?
  projectSummary    String
  scopeOfWork       String[]
  assumptions       String[]
  exclusions        String[]
  estimatedValueMin Decimal? @db.Decimal(14, 2)
  estimatedValueMax Decimal? @db.Decimal(14, 2)
  timeline          String?
  nextSteps         String[]
  disclaimer        String
  status            String   @default("DRAFT")
  generatedBy       String   @default("AI")
  proposalNumber    String?
  validUntil        DateTime?
  version           Int      @default(1)
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([businessId, status, createdAt])
  @@index([leadId, createdAt])
  @@unique([businessId, proposalNumber])
  @@map("proposal_drafts")
}

model PaymentSettings {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  provider           PaymentProvider @default(XENDIT)
  secretKey          String?
  webhookToken       String?
  isActive           Boolean  @default(false)
  testMode           Boolean  @default(true)
  manualInstructions String?
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("payment_settings")
}

model PaymentSession {
  id                String               @id @default(cuid())
  businessId        String
  transactionId     String
  provider          PaymentProvider      @default(XENDIT)
  referenceId       String               @unique
  providerSessionId String?              @unique
  paymentLinkUrl    String?
  amount            Decimal              @db.Decimal(14, 2)
  currency          String               @default("IDR")
  status            PaymentSessionStatus @default(PENDING)
  expiresAt         DateTime?
  completedAt       DateTime?
  rawPayload        Json?
  lastError         String?
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transaction       Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([businessId, status, createdAt])
  @@index([transactionId, createdAt])
  @@map("payment_sessions")
}

model WorkspaceSubscription {
  id                    String                      @id @default(cuid())
  businessId            String                      @unique
  plan                  SubscriptionPlan            @default(BETA)
  billingCycle          SubscriptionBillingCycle    @default(MONTHLY)
  status                WorkspaceSubscriptionStatus @default(PENDING_ACTIVATION)
  trialStartsAt         DateTime?
  trialEndsAt           DateTime?
  currentPeriodStartsAt DateTime?
  currentPeriodEndsAt   DateTime?
  cancelAtPeriodEnd     Boolean                     @default(false)
  canceledAt            DateTime?
  graceEndsAt           DateTime?
  activatedAt           DateTime?
  business              Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments              SubscriptionPayment[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([status, trialEndsAt])
  @@index([status, currentPeriodEndsAt])
  @@map("workspace_subscriptions")
}

model SubscriptionPayment {
  id                    String                      @id @default(cuid())
  businessId            String
  subscriptionId        String
  provider              SubscriptionPaymentProvider @default(MIDTRANS)
  orderId               String                      @unique
  providerTransactionId String?                     @unique
  plan                  SubscriptionPlan
  billingCycle          SubscriptionBillingCycle
  amount                Decimal                     @db.Decimal(14, 2)
  currency              String                      @default("IDR")
  status                SubscriptionPaymentStatus   @default(PENDING)
  snapToken             String?
  redirectUrl           String?
  paymentType           String?
  providerStatus        String?
  fraudStatus           String?
  expiresAt             DateTime?
  settledAt             DateTime?
  failureReason         String?
  rawPayload            Json?
